      "arguments": {
       "additionalProperties": true,
       "description": "That tool's arguments.",
       "type": "object"
      },
      "tool": {
       "type": "string"
      }
     },
     "required": [
      "tool",
      "arguments"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "ops"
  ],
  "type": "object"
 },
 "name": "read_batch",
 "strict": false
}
